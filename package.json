{
  "name": "book-tracker",
  "private": true,
  "version": "0.0.0",
  "description": "A cozy book tracker",
  "author": "Book Tracker",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "release": "vite build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.booktracker.app",
    "productName": "Book Tracker",
    "icon": "src/assets/iconBook.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "sass": "^1.108.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
